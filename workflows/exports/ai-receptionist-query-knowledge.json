      "position": [
        848,
        768
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $input.first().json;\nconst errorValue = source.error;\nconst message = typeof errorValue === 'object' && errorValue !== null && typeof errorValue.message === 'string'\n  ? errorValue.message.trim()\n  : typeof errorValue === 'string' ? errorValue.trim() : 'Error sin detalle';\nconst transientPattern = /fetch failed|econnrefused|etimedout|timeout|network|socket|rate limit|status code 5\\d\\d|service unavailable/i;\nconst failureRoute = transientPattern.test(message) ? 'transient' : 'human_review';\nreturn [{\n  json: {\n    ...source,\n    failure_route: failureRoute,\n    failure_message: message,\n    human_review_required: failureRoute === 'human_review',\n  },\n}];"
      },
      "id": "f87f40b7-558a-4fad-8313-8d1e28711382",
      "name": "Lógica — Clasificar fallo consulta",
      "type": "n8n-nodes-base.code",
