      "parameters": {
        "jsCode": "const input=$input.first().json;\nconst confirmationText=typeof input.confirmationText==='string'?input.confirmationText.trim():'';\nconst suppliedToken=typeof input.confirmationToken==='string'?input.confirmationToken.trim():'';\nconst match=confirmationText.match(/^\\s*confirmar\\s+(offer_[A-Za-z0-9_-]{16,128})\\s*[.!?]*\\s*$/i);\nconst token=match?match[1]:suppliedToken;\nconst valid=Boolean(match)&&token===match[1]&&/^offer_[A-Za-z0-9_-]{16,128}$/.test(token);\nreturn [{json:{...input,confirmationText,confirmationToken:token,booking_route:valid?'lookup_offer':'human_review',validation_message:valid?'Confirmación explícita válida; se verificará la oferta operativa.':'La reserva requiere el texto CONFIRMAR seguido del código de la propuesta vigente.'}}];"
      },
