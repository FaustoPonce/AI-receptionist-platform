    {
      "parameters": {
        "jsCode": "const request=$('Lógica — Validar confirmación explícita').first().json;\nconst offer=$input.first().json;\nconst text=value=>typeof value==='string'?value.trim():'';\nconst expiration=new Date(text(offer.expiresAt));\nconst valid=text(offer.offerToken)===text(request.confirmationToken)&&text(offer.status)==='offered'&&text(offer.calendarId)!==''&&text(offer.slotStart)!==''&&text(offer.slotEnd)!==''&&text(offer.timezone)==='America/Argentina/Buenos_Aires'&&!Number.isNaN(expiration.getTime())&&expiration.getTime()>Date.now();\nreturn [{json:{...request,requestedStart:valid?text(offer.slotStart):'',requestedEnd:valid?text(offer.slotEnd):'',calendarId:valid?text(offer.calendarId):'',timezone:valid?'America/Argentina/Buenos_Aires':'',meetingTitle:valid?'Reunión — Consultora demo':'',meetingDescription:valid?'Reserva confirmada explícitamente por el contacto.':'',offer_route:valid?'consume':'human_review',offer_validation_message:valid?'Oferta vigente y coincidente.':'La oferta no existe, venció o ya fue utilizada.'}}];"
      },
