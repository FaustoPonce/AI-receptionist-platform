    {
      "parameters": {
        "jsCode": "const request=$('Lógica — Validar oferta solicitada').first().json;\nconst candidateStart=new Date(request.requestedStart);\nconst candidateEnd=new Date(request.requestedEnd);\nconst now=Date.now();\nconst hasOverlap=$input.all().some(item=>{\n const row=item.json;\n const rowStart=new Date(typeof row.slotStart==='string'?row.slotStart:'');\n const rowEnd=new Date(typeof row.slotEnd==='string'?row.slotEnd:'');\n const expiresAt=new Date(typeof row.expiresAt==='string'?row.expiresAt:'');\n return typeof row.offerToken==='string'&&row.status==='offered'&&!Number.isNaN(rowStart.getTime())&&!Number.isNaN(rowEnd.getTime())&&!Number.isNaN(expiresAt.getTime())&&expiresAt.getTime()>now&&rowStart.getTime()<candidateEnd.getTime()&&rowEnd.getTime()>candidateStart.getTime();\n});\nreturn [{json:{...request,offer_route:hasOverlap?'already_offered':'create',offer_validation_message:hasOverlap?'Existe una oferta vigente que se superpone con ese horario.':'No existe una oferta vigente que se superponga con ese horario.'}}];"
      },
