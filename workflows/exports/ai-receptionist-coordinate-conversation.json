      "id": "1ca7322a-4629-46db-a5b3-b942a85657be",
      "name": "Ollama — Clasificar intención",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -50,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "http://<OLLAMA_HOST>:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'qwen3.5:9b', stream: false, think: false, options: { temperature: 0 }, format: { type: 'object', properties: { intent: { type: 'string', enum: ['knowledge_question','booking_request','booking_confirmation','clarification'] }, needsHumanReview: { type: 'boolean' } }, required: ['intent','needsHumanReview'], additionalProperties: false }, messages: [ { role: 'system', content: 'Clasificá únicamente la intención del último mensaje recibido por una consultora. No respondas al cliente, no inventes información, no propongas horarios y no realices acciones. knowledge_question: consulta de información. booking_request: pide coordinar, agendar o reservar. booking_confirmation: confirma de forma explícita una oferta recibida. clarification: saludo, mensaje ambiguo, fuera de alcance o sin una intención segura. needsHumanReview debe ser true ante duda, información sensible, urgencia o si la clasificación no es segura. Respondé solo el JSON del schema.' }, { role: 'user', content: $json.messageText } ] } }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "7a5cfeb2-f596-4b47-aebc-1e4a668a4eba",
      "name": "Lógica — Validar clasificación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        190,
        120
      ],
      "parameters": {
        "jsCode": "const source=$('Lógica — Validar entrada conversacional').first().json;\nconst raw=String($json.message?.content??'').trim();\nlet parsed;\ntry { parsed=JSON.parse(raw); } catch { parsed=null; }\nconst intents=new Set(['knowledge_question','booking_request','booking_confirmation','clarification']);\nconst valid=parsed&&typeof parsed==='object'&&intents.has(parsed.intent)&&typeof parsed.needsHumanReview==='boolean';\nif(!valid) {\n  return [{json:{...source,outcome:'human_review',classificationStatus:'invalid_model_output',human_review_required:true,next_action:'Revisar la salida inválida del clasificador antes de responder.',automationEligible:false}}];\n}\nreturn [{json:{...source,intent:parsed.intent,needsHumanReview:parsed.needsHumanReview,classificationStatus:'accepted',classification_route:parsed.needsHumanReview?'human_review':parsed.intent,automationEligible:false}}];"
      }
    },
    {
      "id": "73c86d43-c703-417b-8daa-b75adfe6cf13",
      "name": "Operación — Preparar siguiente paso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        430,
        120
      ],
      "parameters": {
        "jsCode": "if($json.outcome==='human_review') return [{json:{...$json,route:'human_review',automationEligible:false}}];\nconst nextActions={\nknowledge_question:'Consultar conocimiento documentado y preparar una respuesta con evidencia.',\nbooking_request:'Pedir o interpretar datos de agenda antes de consultar disponibilidad.',\nbooking_confirmation:'Validar una oferta vigente antes de reservar una reunión.',\nclarification:'Pedir una aclaración breve antes de continuar.',\nhuman_review:'Derivar el mensaje a revisión humana antes de responder.'\n};\nconst route=$json.classification_route||'human_review';\nreturn [{json:{...$json,outcome:'classification_ready',route,next_action:nextActions[route]||nextActions.human_review,automationEligible:false}}];"
      }
    },
