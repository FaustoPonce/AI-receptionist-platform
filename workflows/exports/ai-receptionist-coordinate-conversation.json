    {
      "id": "e9f379c3-7580-4898-9211-2e2549aae8a9",
      "name": "Lógica — Extraer horario de reunión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        160
      ],
      "parameters": {
        "jsCode": "const source=$json;\nconst text=String(source.messageText??'').trim();\nconst match=text.match(/(?:^|\\s)(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})\\s+(?:a\\s+las\\s+)?([01]?\\d|2[0-3]):([0-5]\\d)(?:\\s|$)/i);\nif(!match) return [{json:{...source,outcome:'booking_clarification_ready',route:'booking_request',responseDraft:'Para revisar disponibilidad, decime un horario de 30 minutos como DD/MM/AAAA HH:MM. Ejemplo: 24/09/2026 15:00.',automationEligible:true}}];\nconst [,day,month,year,hour,minute]=match;\nconst check=new Date(Date.UTC(Number(year),Number(month)-1,Number(day)));\nif(check.getUTCFullYear()!==Number(year)||check.getUTCMonth()!==Number(month)-1||check.getUTCDate()!==Number(day)) return [{json:{...source,outcome:'booking_clarification_ready',route:'booking_request',responseDraft:'La fecha no es válida. Indicame un horario de 30 minutos como DD/MM/AAAA HH:MM.',automationEligible:true}}];\nconst start=new Date(`${year}-${month.padStart(2,'0')}-${day.padStart(2,'0')}T${hour.padStart(2,'0')}:${minute}:00-03:00`);\nconst end=new Date(start.getTime()+30*60*1000);\nif(start.getTime()<=Date.now()) return [{json:{...source,outcome:'booking_clarification_ready',route:'booking_request',responseDraft:'Necesito una fecha y horario futuros para revisar disponibilidad.',automationEligible:true}}];\nreturn [{json:{...source,booking_route:'offer',requestedStart:start.toISOString(),requestedEnd:end.toISOString(),requestedSlotLabel:`${day.padStart(2,'0')}/${month.padStart(2,'0')}/${year} ${hour.padStart(2,'0')}:${minute}`,calendarId:'faustoponceb@gmail.com',timezone:'America/Argentina/Buenos_Aires',offerExpiresAt:new Date(Date.now()+15*60*1000).toISOString()}}];"
      }
    },
