        "jsCode": "const source=$('Lógica — Extraer horario de reunión').first().json;\nconst outcome=String($json.outcome??source.outcome??'');\nif(outcome==='booking_clarification_ready') return [{json:source}];\nif(outcome==='booking_offer_created') return [{json:{...source,outcome:'booking_offer_ready',route:'booking_request',responseDraft:`Tengo disponible el ${source.requestedSlotLabel} para una reunión de 30 minutos. La propuesta vence en 15 minutos. Respondé CONFIRMAR ${String($json.offerToken)} para continuar.`,automationEligible:true}}];\nif(outcome==='slot_unavailable'||outcome==='slot_already_offered') return [{json:{...source,outcome:'booking_slot_unavailable',route:'booking_request',responseDraft:'Ese horario no está disponible. Indicame otra fecha y hora en formato DD/MM/AAAA HH:MM.',automationEligible:true}}];\nreturn [{json:{...source,outcome:'human_review',human_review_required:true,next_action:'Revisar el resultado de la oferta antes de responder.',automationEligible:false}}];"
