    {
      "id": "8af6a21a-81ff-4001-8a2a-a92a63b9c939",
      "name": "Lógica — Validar entrada conversacional",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        210
      ],
      "parameters": {
        "jsCode": "const messageId=String($json.messageId??'').trim();\nconst from=String($json.from??'').replace(/[^0-9]/g,'');\nconst contactName=String($json.contactName??'').trim();\nconst messageText=String($json.messageText??'').trim();\nconst receivedAt=String($json.receivedAt??'').trim();\nconst phoneNumberId=String($json.phoneNumberId??'').trim();\nconst errors=[];\nif(messageId.length<1||messageId.length>256) errors.push('messageId inválido.');\nif(!/^\\d{7,15}$/.test(from)) errors.push('from debe incluir código de país y tener entre 7 y 15 dígitos.');\nif(contactName.length>160) errors.push('contactName supera 160 caracteres.');\nif(messageText.length<1||messageText.length>1000) errors.push('messageText debe tener entre 1 y 1000 caracteres.');\nif(Number.isNaN(Date.parse(receivedAt))) errors.push('receivedAt debe ser una fecha ISO válida.');\nif(!/^\\d{1,20}$/.test(phoneNumberId)) errors.push('phoneNumberId inválido.');\nreturn [{json:{messageId,from,contactName,messageText,receivedAt,phoneNumberId,input_route:errors.length===0?'classify':'human_review',validationErrors:errors}}];"
      }
    },
