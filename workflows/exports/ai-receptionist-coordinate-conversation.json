      ],
      "parameters": {
        "jsCode": "const source=$('Lógica — Validar clasificación').first().json;\nconst responseDraft=String($json.output??'').trim();\nif(responseDraft.length<1||responseDraft.length>2000) {\n  return [{json:{...source,outcome:'human_review',human_review_required:true,knowledgeStatus:'invalid_or_missing_answer',next_action:'Revisar la respuesta de conocimiento antes de enviar cualquier mensaje.',automationEligible:false}}];\n}\nreturn [{json:{...source,outcome:'knowledge_answer_ready',route:'knowledge_question',knowledgeStatus:'validated',responseDraft,next_action:'Revisar la respuesta respaldada antes de conectarla al envío de WhatsApp.',automationEligible:false}}];"
