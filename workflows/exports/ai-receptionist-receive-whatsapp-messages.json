      "name": "Lógica — Validar desafío Meta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -980,
        -140
      ],
      "parameters": {
        "jsCode": "const query=$json.query||{};\nconst mode=query['hub.mode']||'';\nconst verifyToken=query['hub.verify_token']||'';\nconst challenge=query['hub.challenge']||'';\nconst valid=mode==='subscribe'&&typeof challenge==='string'&&verifyToken===$env.META_WEBHOOK_VERIFY_TOKEN;\nreturn [{json:{challenge,verification_route:valid?'accept':'reject'}}];"
      }
    },
