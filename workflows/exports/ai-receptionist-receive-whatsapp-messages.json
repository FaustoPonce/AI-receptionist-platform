    {
      "id": "81b44bc3-0580-4d12-b7d7-5c71f9bd6b73",
      "name": "Lógica — Validar firma Meta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -980,
        180
      ],
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst input=items[0]||{};\nconst payload=input.json||{};\nconst headers=payload.headers||{};\nconst supplied=headers['x-hub-signature-256']||headers['X-Hub-Signature-256']||'';\nconst encodedRaw=input.binary?.data?.data;\nconst rawText=typeof encodedRaw==='string'?Buffer.from(encodedRaw,'base64').toString('utf8'):null;\nconst expected=rawText===null?'':'sha256='+crypto.createHmac('sha256',$env.META_APP_SECRET).update(rawText).digest('hex');\nconst valid=rawText!==null&&typeof supplied==='string'&&supplied.length===expected.length&&crypto.timingSafeEqual(Buffer.from(supplied),Buffer.from(expected));\nreturn [{json:{...payload,signature_route:valid?'parse':'human_review'},binary:input.binary}];"
      }
    },
