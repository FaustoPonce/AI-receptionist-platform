      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -540,
        120
      ],
      "parameters": {
        "jsCode": "const value=$json.body?.entry?.[0]?.changes?.[0]?.value||{};\nconst message=value.messages?.[0];\nconst contact=value.contacts?.[0]||{};\nconst metadata=value.metadata||{};\nif(!message||message.type!=='text'||typeof message.id!=='string'||typeof message.from!=='string'||typeof message.text?.body!=='string'){\n return [{json:{event_route:'ignore',reason:'El evento no contiene un mensaje de texto entrante procesable.'}}];\n}\nreturn [{json:{event_route:'process',channel:'whatsapp',messageId:message.id,from:message.from,contactName:typeof contact.profile?.name==='string'?contact.profile.name:'',messageText:message.text.body,receivedAt:new Date(Number(message.timestamp)*1000).toISOString(),phoneNumberId:metadata.phone_number_id||''}}];"
      }
    },
