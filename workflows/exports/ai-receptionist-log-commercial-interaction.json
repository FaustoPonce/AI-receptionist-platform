    {
      "parameters": {
        "jsCode": "const input=$input.first().json;\nconst text=value=>typeof value==='string'?value.trim():'';\nconst fullName=text(input.fullName),rawPhone=text(input.phone),message=text(input.message),interactionKey=text(input.interactionKey),receivedAt=text(input.receivedAt),source=text(input.source);\nconst digits=rawPhone.replace(/\\D/g,'');\nconst receivedDate=new Date(receivedAt);\nconst valid=fullName.length>=2&&digits.length>=10&&digits.length<=15&&message.length>=1&&message.length<=5000&&interactionKey.length>=8&&interactionKey.length<=255&&source==='whatsapp'&&!Number.isNaN(receivedDate.getTime());\nreturn [{json:{...input,fullName,phone:digits?'+'+digits:'',phoneSearch:digits.length>=10?digits.slice(-10):'',message,interactionKey,receivedAt,crm_route:valid?'check_idempotency':'human_review',validationMessage:valid?'Interacción válida; se verifica idempotencia antes de tocar HubSpot.':'Se requiere nombre, teléfono, mensaje, identificador único del mensaje y fecha ISO válidos.'}}];"
      },
