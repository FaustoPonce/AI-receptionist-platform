    {
      "parameters": {
        "jsCode": "const request=$('Lógica — Evaluar idempotencia').first().json;\nconst response=$input.first().json||{};\nif(response.error) return [{json:{...request,contact_route:'human_review',reviewReason:'Falló la búsqueda del contacto en HubSpot.'}}];\nconst rawContacts=Array.isArray(response.results)?response.results:[];\nconst contacts=[...new Map(rawContacts.filter(contact=>typeof contact?.id==='string').map(contact=>[contact.id,contact])).values()];\nif(contacts.length===0) return [{json:{...request,contact_route:'create_contact'}}];\nif(contacts.length===1) return [{json:{...request,contact_route:'existing_contact',hubspotContactId:contacts[0].id}}];\nreturn [{json:{...request,contact_route:'human_review',reviewReason:'Hay más de un contacto que coincide con el teléfono; no se asociará automáticamente.'}}];"
      },
