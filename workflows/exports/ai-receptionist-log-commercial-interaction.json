    {
      "parameters": {
        "jsCode": "const input=$input.first().json||{};\nconst message=typeof input.error==='string'?input.error:typeof input.error?.message==='string'?input.error.message:'Error sin detalle';\nconst route=/fetch failed|econnrefused|etimedout|timeout|network|socket|rate limit|status code 5\\d\\d|service unavailable/i.test(message)?'transient':'human_review';\nreturn [{json:{failure_route:route,failure_message:message,human_review_required:route==='human_review'}}];"
      },
