    {
      "parameters": {
        "jsCode": "const request=$('Lógica — Validar interacción').first().json;\nconst row=$input.first().json||{};\nif(row.error) return [{json:{...request,crm_route:'human_review',reviewReason:'No se pudo consultar la idempotencia operativa.'}}];\nif(!row.interactionKey) return [{json:{...request,crm_route:'lookup_contact'}}];\nif(row.status==='registered') return [{json:{...request,crm_route:'already_registered',hubspotContactId:row.hubspotContactId||'',hubspotNoteId:row.hubspotNoteId||''}}];\nreturn [{json:{...request,crm_route:'human_review',reviewReason:'Existe una interacción pendiente que requiere revisión antes de reintentar.'}}];"
      },
