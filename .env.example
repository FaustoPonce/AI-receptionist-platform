# Valores locales de referencia. No agregar credenciales reales en este archivo.
TIMEZONE=America/Argentina/Buenos_Aires

# n8n corre en Docker y llega a los servicios del host por host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5

QDRANT_URL=http://host.docker.internal:6333
QDRANT_COLLECTION=consultora_knowledge_v1
QDRANT_VECTOR_SIZE=768

# Configurar estos valores solo en el entorno local de n8n; nunca versionar sus valores reales.
META_WEBHOOK_VERIFY_TOKEN=<CONFIGURE_MANUALLY>
META_APP_SECRET=<CONFIGURE_MANUALLY>
